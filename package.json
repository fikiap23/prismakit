{
  "name": "prismakit",
  "private": true,
  "version": "0.0.0",
  "description": "Prisma repository kit with cache-aside, auto-compose, and row locks",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "test": "node scripts/prepare-pg-integration.mjs && turbo run test",
    "test:coverage": "vitest run --coverage",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "verify:publish": "node scripts/verify-publish-manifest.mjs",
    "release": "pnpm build && pnpm verify:publish && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "prisma": "^7.10.1",
    "tsup": "^9.0.0",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
