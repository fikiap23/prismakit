{
  "name": "@prismakit/redis",
  "version": "2.2.2",
  "description": "Redis CacheAdapter for @prismakit/core",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --sourcemap",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prismakit/core": "workspace:*"
  },
  "peerDependencies": {
    "@prismakit/core": ">=2.2.2",
    "ioredis": ">=5.0.0"
  },
  "devDependencies": {
    "ioredis": "^5.6.0",
    "typescript": "^5.9.2",
    "tsup": "^8.4.0",
    "vitest": "^3.0.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fikiap23/prismakit.git"
  },
  "bugs": {
    "url": "https://github.com/fikiap23/prismakit/issues"
  },
  "homepage": "https://github.com/fikiap23/prismakit/tree/master/packages/redis#readme",
  "keywords": [
    "prisma",
    "redis",
    "cache",
    "ioredis",
    "prismakit"
  ]
}
