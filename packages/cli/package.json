{
  "name": "@prismakit/cli",
  "version": "4.0.1",
  "description": "CLI for PrismaKit — generate modules, validate compose, install agent skills",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "prismakit": "./dist/bin.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "skills",
    "rules",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prismakit/core": "workspace:*"
  },
  "peerDependencies": {
    "@prismakit/core": ">=4.0.1 <5"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "tsup": "^8.4.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fikiap23/prismakit.git"
  },
  "bugs": {
    "url": "https://github.com/fikiap23/prismakit/issues"
  },
  "homepage": "https://github.com/fikiap23/prismakit/tree/master/packages/cli#readme",
  "keywords": [
    "prisma",
    "cli",
    "prismakit",
    "cursor",
    "skills"
  ]
}
