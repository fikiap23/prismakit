{
  "name": "@prismakit/opentelemetry",
  "version": "4.0.1",
  "description": "OpenTelemetry adapter for @prismakit/core telemetry events",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --sourcemap",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prismakit/core": "workspace:*"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0",
    "@prismakit/core": ">=4.0.1 <5"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "typescript": "^7.0.2",
    "tsup": "^8.4.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fikiap23/prismakit.git"
  },
  "bugs": {
    "url": "https://github.com/fikiap23/prismakit/issues"
  },
  "homepage": "https://github.com/fikiap23/prismakit/tree/master/packages/opentelemetry#readme",
  "keywords": [
    "prisma",
    "opentelemetry",
    "telemetry",
    "observability",
    "prismakit"
  ]
}
