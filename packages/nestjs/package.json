{
  "name": "@prismakit/nestjs",
  "version": "2.1.0",
  "description": "NestJS integration for @prismakit/core — PrismaKitModule, TransactionService, injectable repositories",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean --sourcemap",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@prismakit/core": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
    "@nestjs/core": ">=10.0.0",
    "@prismakit/core": ">=2.1.0",
    "@prismakit/redis": ">=2.1.0"
  },
  "peerDependenciesMeta": {
    "@prismakit/redis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.2",
    "tsup": "^8.4.0",
    "vitest": "^3.0.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fikiap23/prismakit.git"
  },
  "bugs": {
    "url": "https://github.com/fikiap23/prismakit/issues"
  },
  "homepage": "https://github.com/fikiap23/prismakit/tree/master/packages/nestjs#readme",
  "keywords": [
    "prisma",
    "nestjs",
    "repository",
    "cache",
    "prismakit"
  ]
}
